; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="My Dream Boyfriend"
run/main_scene="uid://64vxlrikrmg"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*uid://cqq0raxsqbvi3"
DialogueController="uid://b43wm5x2u3xqv"
Inventory="*uid://dbcnanje3a5ow"
SceneManager="*uid://uonotqecw5d2"
SaveManager="*uid://dvckdinytfnkx"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"boyfriend": "res://game_ui/boyfriend.dch",
"mc": "res://game_ui/mc.dch"
}
directories/dtl_directory={
"timeline": "res://timeline.dtl"
}
layout/style_directory={
"": "res://game_ui/dialogue_style.tres",
"dialogue_style": "res://game_ui/dialogue_style.tres"
}
layout/style_list=["res://game_ui/dialogue_style.tres"]
layout/default_style="res://game_ui/dialogue_style.tres"
variables={
"lovemeter": 0
}

[dialogue_manager]

runtime/balloon_path="res://game_ui/balloon.tscn"

[display]

window/size/viewport_width=1024
window/size/viewport_height=1024
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

